{
  "name": "graphdb-workbench-plugins",
  "version": "0.0.1-TR27",
  "description": "Plugins for GraphDB workbench",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ontotext AD",
  "files": [
    "dist/",
    "./plugins-manifest.json"
  ],
  "scripts": {
    "dev": "nodemon --watch plugins --ext js,json --exec \"npm run build\"",
    "pre:document": "rimraf -g docs/[!resource]*",
    "post:document": "node scripts/post-jsdoc.js",
    "document": "npm run pre:document && jsdoc -c jsdoc.config.json && npm run post:document",
    "build": "webpack --config webpack.config.js",
    "validate-manifest": "node scripts/validate-manifest.js",
    "validate-guides-translations": "node scripts/validate-guides-translations.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install:ci": "npm ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/js": "^9.33.0",
    "ajv": "^8.17.1",
    "babel-loader": "^10.0.0",
    "better-docs": "^2.7.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.34.0",
    "eslint-config-google": "^0.14.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.4",
    "nodemon": "^3.1.10",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
